# Plantilla de variables de entorno. Copiar a .env y completar los valores.

# --- PostgreSQL ---
POSTGRES_DB=taller_db
POSTGRES_USER=taller_user
POSTGRES_PASSWORD=cambiar_esto

# --- Flask (web) ---
# Host de la BD = nombre del servicio en la red interna de Docker
DB_HOST=db
DB_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@taller.com
PGADMIN_DEFAULT_PASSWORD=cambiar_esto
    